{
  "name": "smart-control-backend",
  "version": "0.1.0",
  "description": "展贸中心智能化中控系统 - 后端服务",
  "author": "Smart Control Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "admin:provision": "node scripts/provision-first-admin.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "schema:log": "typeorm-ts-node-commonjs schema:log -d src/data-source.ts",
    "test": "jest",
    "test:ops": "node --test test/*.test.cjs",
    "pm2:start": "pm2 start ../deploy/ecosystem.config.js",
    "pm2:stop": "pm2 stop smart-control-backend",
    "pm2:restart": "pm2 restart smart-control-backend",
    "pm2:logs": "pm2 logs smart-control-backend",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-ws": "^11.2.5",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.5",
    "better-sqlite3": "^11.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "cron": "^3.5.0",
    "mqtt": "^5.16.0",
    "multer": "2.4.0",
    "nest-winston": "^1.9.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serialport": "^13.0.0",
    "typeorm": "^0.3.31",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/compression": "^1.8.1",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.9",
    "ts-jest": "^29.2.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "body-parser": "1.20.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.6",
      "file-type": "21.3.2",
      "ip-address": "10.3.1",
      "lodash": "4.18.1",
      "multer": "2.4.0",
      "qs": "6.16.0",
      "uuid@11": "11.1.1",
      "ws": "8.21.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
