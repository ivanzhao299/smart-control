# ===========================================
# 展贸中心智能化中控系统 - 环境变量
# ===========================================

# 应用配置
PORT=3000
NODE_ENV=development
APP_NAME=smart-control-backend

# 数据库配置 (SQLite)
DB_PATH=../database/smart-control.db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# 日志配置
LOG_LEVEL=info
LOG_DIR=../logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# API 配置
API_PREFIX=/api
API_TIMEOUT=30000
# 浏览器跨域来源白名单（逗号分隔、必须写完整 origin，禁止 *）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 设备适配器: MOCK_MODE=true 时所有适配器返回 mock 数据 (不发真实协议)
MOCK_MODE=true
MOCK_LATENCY_MS=80
DEVICE_TIMEOUT_MS=3000
DEVICE_RETRIES=3

# ============ ePa 4G 智能断路器 (MQTT) ============
# 设备和本系统分别连接同一公网 broker。服务器可由本项目自建；生产默认关闭，
# 待厂家协助把我们的 broker 参数写入设备，并取得网关 ID / ClientID 后再启用。
EPA_MQTT_ENABLED=false
# EPA_MQTT_URL=mqtt://mqtt.example.com:1883
# EPA_MQTT_CLIENT_ID=smart-control-gk9000
# EPA_MQTT_USERNAME=
# EPA_MQTT_PASSWORD=
EPA_MQTT_COMMAND_TIMEOUT_MS=5000
# 主动上报超过此时间即认为缓存过期并向设备发起单设备读取 (bid=208)
EPA_MQTT_STALE_MS=600000

# ============ ePa 4G 断路器走华普云 Web API (庭院亮化/鱼池供氧/园区路灯) ============
# 设备内置 4G，经厂家云平台 https://www.hperfor.com/homeschool 登录后下发分/合闸。
# 账号为平台登录账号；留空则该类设备只保存配置、不下发。切勿提交真实值。
HPERFOR_API_BASE_URL=https://www.hperfor.com/homeschool
HPERFOR_API_USERNAME=
HPERFOR_API_PASSWORD=

# ============ 易微联 eWeLink 云开关 (酷宅云, OAuth2.0) ============
# 开发者后台 https://dev.ewelink.cn 创建 OAuth 应用拿 AppID/AppSecret；
# 授权回调需与应用登记一致: https://erp.cnjinhu.com/api/integrations/ewelink/callback
# 首次授权在后台「设备网络」页点「前往授权」；留空则该集成不启用。切勿提交真实值。
EWELINK_APP_ID=p5XVbutJXVl88g6r33l79uqzGKofDee8
EWELINK_APP_SECRET=
# 公网基址, 用于拼 OAuth 回调；默认 https://erp.cnjinhu.com
PUBLIC_BASE_URL=https://erp.cnjinhu.com

# 网关状态按实际控制结果更新；需要诊断时在“系统状态”页手动检测。
# 不在后台定时探活，避免展厅停电期间产生无意义连接和离线告警。

# ============ DALI 灯光 ============
# 适配器选型: cy-dali64a (默认, 元创智控 RS485 Modbus RTU) | iot-gateway (通用 HTTP REST) | mock
LIGHTING_ADAPTER_KIND=cy-dali64a

# CY-DALI64A (走 RTU-over-TCP 转换器, 例如 USR-TCP232 / Moxa MGate)
DALI_RTU_HOST=192.168.50.20
DALI_RTU_PORT=502
DALI_RTU_SLAVE_ID=1              # 网关拨码盘地址, 多台并联各设不同号
DALI_RTU_FRAME_INTERVAL_MS=200   # 帧间隔, 文档要求 ≥150ms
DALI_RTU_DEFAULT_FADE_SEC=0.7    # 默认渐变时间

# (向后兼容) DALI IoT Gateway HTTP REST — 仅 LIGHTING_ADAPTER_KIND=iot-gateway 时使用
DALI_GATEWAY_HOST=192.168.50.20
DALI_GATEWAY_PORT=80
DALI_API_PATH=/control
# DALI_API_KEY=

# ============ LED 大屏 (诺瓦 NovaStar VX1000 + Intel NUC) ============
# VX1000 视频处理器 (TCP:5200, NovaStar VX 私有 hex 协议)
LED_HOST=192.168.50.30
LED_PORT=5200
# 屏幕分辨率 (现场实际 LED 模组拼接后的总像素), 影响图层全屏占位计算
LED_RESOLUTION_WIDTH=3612
LED_RESOLUTION_HEIGHT=1462
# 高级预设号（当前 GK9000 浏览器播放链路不依赖这两个历史预设）
LED_PRESET_WELCOME=1
LED_PRESET_VIDEO=2
# 开屏后默认亮度 (0-100)
LED_DEFAULT_BRIGHTNESS_PCT=80

# NUC 媒体播控主机 (可选, 设了才支持播放具体视频文件)
# LED_NUC_HOST=192.168.50.31
# LED_NUC_PORT=8080

# 音响 DSP (DSPPA / ITC)
AUDIO_HOST=192.168.50.40
AUDIO_PORT=80
AUDIO_DEFAULT_ZONE=1f_bg
# AUDIO_API_KEY=

# ============ 空调 (奥克斯商用 VRF ARV-X9 + 中弘 B 集控网关 TCP 款) ============
# 外机: 2 台 (一拖多)
#   - 1F: 奥克斯 DLR-785W5/DCM-ARVX9, 35.5 kW, 57A (带 10 台内机)
#   - 2F: 奥克斯 DLR-1015W5/DCM-ARVX9, 40.8 kW, 64A (带 12 台内机)
# 网关: 2 台中弘 B 集控网关 TCP 款 (各 ~¥1,200, 协议 MBT V3.2)
#   - 1F 网关 192.168.50.51:502 → 1F 外机 → 内机 n=0..9
#   - 2F 网关 192.168.50.52:502 → 2F 外机 → 内机 n=0..11
#   - 直接接弱电交换机, 不需要 USR-TCP232 转换器
# 内机寻址 (device.address JSON):
#   {"gwHost":"192.168.50.51","n":0,"model":"DLR-63F","kw":1.8}
#   寄存器映射见 backend/src/adapters/hvac/zhonghong-mbt-protocol.ts
#   状态地址 = 6n; 控制地址 = 4000 + 4n
# 下面 HVAC_HOST/HVAC_PORT 仅给健康检查 ping 用 (默认 ping 1F 网关)
HVAC_HOST=192.168.50.51
HVAC_PORT=502
HVAC_DEFAULT_SLAVE_ID=1

# WebSocket
WS_PATH=/ws/status

# ============ 现场可写运行时数据目录 ============
# 存放 video-binding.json(视频绑定+AI计数线/ROI)、park-ops-metrics.json(运营KPI)、
# park-ops-control.json(播控状态)。必须指向 git 仓库之外, 否则部署会覆盖/删除现场值。
# 生产由 deploy/ecosystem.config.js 自动注入(Windows=D:\smart-control-runtime\data),
# 一般无需在此设置; 如手动设置, 必须与 ecosystem / scripts/backup.ps1 解析结果一致。
# DATA_DIR=D:\smart-control-runtime\data

# ============ TestFlight 内部测试员邀请 (后台「iOS 测试」页) ============
# 服务端常驻一把 App Store Connect「App Manager」专用密钥 (不是 Admin 钥),
# 由后台直接调 App Store Connect API 邀请内部测试员 (固定 MARKETING 最小权限、
# 仅可见下面这个 App)。私钥属机密: 只写在服务器 backend/.env, 不要提交进 git。
#
# 密钥在 ASC「用户和访问 → 集成 → 团队密钥」生成; Issuer ID 在同一页顶部。
# P8 私钥只能下载一次。部署时把整份 .p8 做 base64 后填到 TESTFLIGHT_P8_BASE64:
#   macOS/Linux: base64 -i AuthKey_XXXXXXXXXX.p8
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("AuthKey_XXXXXXXXXX.p8"))
# TESTFLIGHT_ENABLED=false 可在不撤密钥的情况下临时停用该功能。
# TESTFLIGHT_ISSUER_ID=46f3175f-8ef3-4dc8-8690-64bdc0be3ff1
# TESTFLIGHT_KEY_ID=DJ3328P729
# TESTFLIGHT_P8_BASE64=
# 也可改为给文件路径: TESTFLIGHT_P8_PATH=D:\smart-control\secrets\AuthKey_DJ3328P729.p8
# TESTFLIGHT_APP_ID=6795375392
# TESTFLIGHT_BUNDLE_ID=com.jinhu.smartcontrol
# TESTFLIGHT_INTERNAL_GROUP_NAME=内部测试
# TESTFLIGHT_TESTER_ROLE=MARKETING
# TESTFLIGHT_ENABLED=true
#
# 一键续期 (TestFlight 每个 build 仅 90 天有效且不可延长): 后台按钮触发 GitHub Actions
# 在 macOS 上重新归档/云签名/上传新 build。需要一把仅用于此的 GitHub Token:
#   classic PAT 勾选 repo + workflow; 或 fine-grained 仅授本仓库 Actions 读写。
# Token 属机密, 只写服务器 backend/.env, 不要提交进 git。
# TESTFLIGHT_RENEW_TOKEN=
# TESTFLIGHT_RENEW_REPO=ivanzhao299/smart-control
# TESTFLIGHT_RENEW_WORKFLOW=ios-build.yml
# TESTFLIGHT_RENEW_REF=main

# ============ 锦浪云 (Ginlong / SolisCloud) 光伏发电 ============
# 单账号开放 API, HMAC-SHA1 鉴权。在锦浪云「用户中心 → API」生成 KeyID/KeySecret。
# 密钥属机密: 只写在服务器 backend/.env(.local), 不要提交进 git。
# 两者齐全即启用; GINLONG_ENABLED=false 可临时停用 (大屏回退内置静态展示)。
# GINLONG_KEY_ID=
# GINLONG_KEY_SECRET=
# 中国区默认值 (一般无需修改):
GINLONG_BASE_URL=https://api.ginlong.com:13333
GINLONG_REFRESH_MS=60000
GINLONG_TIMEOUT_MS=12000

# ============ em123 智慧能源管理平台 (电/水表 4G 透传上云, 只读) ============
# 预付费抄表 SaaS (若依框架), 账号密码登录后只读采集表档案/日用量/小时负荷。
# 账号+密码齐全即启用; EM123_ENABLED=false 可临时停用 (大屏电表回退)。
# 凭证属机密: 只写在服务器 backend/.env(.local), 不要提交进 git。
# EM123_ENABLED=true
EM123_BASE_URL=https://www.em123.cc
# EM123_USERNAME=
# EM123_PASSWORD=
# EM123_BOOTSTRAP_DAYS=180
# EM123_REFRESH_HOURLY_MS=1800000
# EM123_BOOTSTRAP_HOURLY_DAYS=7
# EM123_TIMEOUT_MS=120000
